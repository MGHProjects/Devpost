<!--
  HANDCAST HUD. Sections share one panel and are toggled by src/hc/hud.ts:
  #play (current board), #menu (puzzle select), #studio (editor), #hall (community).
  Plain ASCII copy only (font coverage).

  Dark night-studio glass: src/hc/hud.ts puts the Horizon kit in dark mode
  (its buttons follow) and the .root div draws the glass surface (the stock
  Horizon <Panel> keeps its own surface over class styles). 1 px is 1 mm in
  the world (scene scale 0.1 x UIKit 0.01 m per px). Seen from a seated head
  ~0.57-0.64 m away, 1 degree of arc is 10-11 mm, so primary text is >= 16 px (Inter
  cap height 0.73 em = 11.6 mm). Every section is short and wide so the whole
  panel sits between the bench crystals and the top of a 70 x 66 degree view.
  "-hc" classes are the Large text / high contrast variants: hud.ts adds them
  next to their base class at runtime.
-->
<style>
  .root {
    flex-direction: column;
    padding-top: 12px;
    padding-bottom: 12px;
    border-radius: 20px;
    border-width: 1.5px;
    border-color: rgba(143, 208, 255, 0.34);
    background-color: rgba(3, 5, 10, 0.93);
  }
  .root-hc {
    border-width: 3px;
    border-color: #ffffff;
    background-color: rgba(0, 0, 0, 0.97);
  }
  .section {
    flex-direction: column;
    padding-left: 20px;
    padding-right: 20px;
  }
  .fixed-w {
    width: 640px;
  }
  .fixed-w-hc {
    width: 676px;
  }
  .head-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .head-text {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    gap: 12px;
  }
  .eyebrow {
    flex-grow: 1;
    flex-shrink: 1;
    text-align: right;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.2px;
    line-height: 1.25;
    color: #a9c6e0;
  }
  .eyebrow-hc {
    font-size: 16px;
    color: #ffffff;
  }
  .title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    color: #f5f7fb;
  }
  .title-hc {
    font-size: 27px;
    color: #ffffff;
  }
  .status {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.25;
    color: #dfe5f0;
  }
  .status-hc {
    font-size: 19px;
    font-weight: 600;
    color: #ffffff;
  }
  .meter {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    gap: 5px;
  }
  .chip {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #8fd0ff;
    align-items: center;
    justify-content: center;
    background-color: rgba(143, 208, 255, 0.16);
  }
  .chip-hc {
    width: 34px;
    height: 34px;
    border-radius: 9px;
  }
  .chip-t {
    font-size: 15px;
    font-weight: 800;
    color: #8fd0ff;
  }
  .chip-t-hc {
    font-size: 19px;
  }
  .chip-k {
    width: 18px;
    height: 18px;
    color: #070a10;
  }
  .chip-k-hc {
    width: 23px;
    height: 23px;
  }
  .tokens {
    flex-direction: row;
    align-items: center;
    gap: 5px;
  }
  .glass-token {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #8fd0ff;
    border-width: 2px;
    border-color: #8fd0ff;
  }
  .glass-token-hc {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 3px;
  }
  .grow {
    flex-grow: 1;
  }
  .row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding-left: 20px;
    padding-right: 20px;
  }
  .tight {
    gap: 6px;
    margin-top: 8px;
  }
  .tool {
    padding-left: 12px;
    padding-right: 12px;
  }
  .button-label {
    font-size: 16px;
    transform-translate-y: 1px;
  }
  .button-label-hc {
    font-size: 19px;
    font-weight: 700;
  }
  .wide-btn {
    width: 136px;
  }
  .wide-btn-hc {
    width: 160px;
  }
  .menu-body {
    flex-direction: row;
    gap: 22px;
    padding-left: 20px;
    padding-right: 20px;
  }
  .menu-grid {
    flex-direction: column;
    gap: 4px;
  }
  .menu-side {
    flex-direction: column;
    gap: 6px;
  }
  .side-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }
  .btn-col {
    flex-direction: column;
    gap: 6px;
  }
  .btn-pair {
    flex-direction: row;
    gap: 6px;
  }
  .grid-row {
    flex-direction: row;
    align-items: center;
    gap: 4px;
  }
  .movement-label {
    flex-shrink: 0;
    width: 112px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #a9c6e0;
  }
  .tour-label {
    color: #ffd76a;
  }
  .movement-label-hc {
    width: 132px;
    font-size: 16px;
    color: #ffffff;
  }
  .cell-btn {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }
  .cell-btn-hc {
    width: 28px;
    height: 28px;
    border-width: 2px;
    border-color: #ffffff;
  }
  .cell-label {
    font-size: 14px;
    font-weight: 700;
    color: #eef2f8;
  }
  .cell-label-hc {
    font-size: 17px;
  }
  .hall-grid {
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
  }
  .hall-pair {
    flex-direction: row;
    gap: 8px;
  }
  .hall-row {
    flex-direction: column;
    justify-content: center;
    width: 296px;
    height: 42px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.07);
    cursor: pointer;
  }
  .hall-row-hc {
    width: 334px;
    height: 50px;
    border-width: 2px;
    border-color: #ffffff;
    background-color: #10141c;
  }
  .hall-name {
    font-size: 16px;
    font-weight: 600;
    color: #f3f5fa;
  }
  .hall-name-hc {
    font-size: 19px;
    color: #ffffff;
  }
  .hall-meta {
    font-size: 13px;
    font-weight: 500;
    color: #b9c2d6;
  }
  .hall-meta-hc {
    font-size: 15px;
    color: #ffffff;
  }
  .code {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: #8fd0ff;
  }
  .code-hc {
    font-size: 17px;
    color: #ffffff;
  }
</style>
<div id="hud-root" class="root">
  <div id="play" class="section fixed-w">
    <div class="head-row">
      <div class="head-text">
        <div id="hud-title" class="title">First Light</div>
        <div id="hud-eyebrow" class="eyebrow">PROLOGUE - 1 / 5</div>
      </div>
      <div id="hud-meter" class="meter">
        <div id="meter-0" class="chip"><div id="meter-0-t" class="chip-t">R</div><Check id="meter-0-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-1" class="chip"><div id="meter-1-t" class="chip-t">G</div><Check id="meter-1-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-2" class="chip"><div id="meter-2-t" class="chip-t">B</div><Check id="meter-2-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-3" class="chip"><div id="meter-3-t" class="chip-t">W</div><Check id="meter-3-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-4" class="chip"><div id="meter-4-t" class="chip-t">W</div><Check id="meter-4-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-5" class="chip"><div id="meter-5-t" class="chip-t">W</div><Check id="meter-5-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-6" class="chip"><div id="meter-6-t" class="chip-t">W</div><Check id="meter-6-k" class="chip-k" style="display: none"></Check></div>
        <div id="meter-7" class="chip"><div id="meter-7-t" class="chip-t">W</div><Check id="meter-7-k" class="chip-k" style="display: none"></Check></div>
      </div>
    </div>
    <div id="hud-status" class="status">Rest your palm in the light.</div>
  </div>
  <div id="play-actions" class="row">
    <Button id="btn-undo" variant="secondary" size="sm">
      <ButtonIcon><Undo2></Undo2></ButtonIcon>
      <ButtonLabel class="button-label">Undo</ButtonLabel>
    </Button>
    <Button id="btn-reset" variant="secondary" size="sm">
      <ButtonIcon><RotateCcw></RotateCcw></ButtonIcon>
      <ButtonLabel class="button-label">Reset</ButtonLabel>
    </Button>
    <Button id="btn-hint" variant="secondary" size="sm">
      <ButtonIcon><Lightbulb></Lightbulb></ButtonIcon>
      <ButtonLabel class="button-label">Hint</ButtonLabel>
    </Button>
    <Button id="btn-menu" variant="secondary" size="sm">
      <ButtonIcon><LayoutGrid></LayoutGrid></ButtonIcon>
      <ButtonLabel class="button-label">Menu</ButtonLabel>
    </Button>
    <Button id="btn-like" size="sm" style="display: none">
      <ButtonIcon><Heart></Heart></ButtonIcon>
      <ButtonLabel id="btn-like-label" class="button-label">Like</ButtonLabel>
    </Button>
    <Button id="btn-next" size="sm">
      <ButtonLabel class="button-label">Next</ButtonLabel>
      <ButtonIcon><ChevronRight></ChevronRight></ButtonIcon>
    </Button>
    <div class="grow"></div>
    <div id="hud-tokens" class="tokens">
      <div id="tok-0" class="glass-token"></div>
      <div id="tok-1" class="glass-token"></div>
      <div id="tok-2" class="glass-token"></div>
      <div id="tok-3" class="glass-token"></div>
    </div>
  </div>

  <div id="menu" class="menu-body" style="display: none">
    <div class="menu-grid">
      <div class="grid-row">
        <div id="tour-label" class="movement-label tour-label">TOUR</div>
        <div id="tour-0" class="cell-btn"><div id="tour-0-t" class="cell-label">1</div></div>
        <div id="tour-1" class="cell-btn"><div id="tour-1-t" class="cell-label">2</div></div>
        <div id="tour-2" class="cell-btn"><div id="tour-2-t" class="cell-label">3</div></div>
        <div id="tour-3" class="cell-btn"><div id="tour-3-t" class="cell-label">4</div></div>
        <div id="tour-4" class="cell-btn"><div id="tour-4-t" class="cell-label">5</div></div>
        <div id="tour-5" class="cell-btn"><div id="tour-5-t" class="cell-label">6</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-0-label" class="movement-label">PROLOGUE</div>
        <div id="lvl-0" class="cell-btn"><div id="lvl-0-t" class="cell-label">1</div></div>
        <div id="lvl-1" class="cell-btn"><div id="lvl-1-t" class="cell-label">2</div></div>
        <div id="lvl-2" class="cell-btn"><div id="lvl-2-t" class="cell-label">3</div></div>
        <div id="lvl-3" class="cell-btn"><div id="lvl-3-t" class="cell-label">4</div></div>
        <div id="lvl-4" class="cell-btn"><div id="lvl-4-t" class="cell-label">5</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-1-label" class="movement-label">I FINGERS</div>
        <div id="lvl-5" class="cell-btn"><div id="lvl-5-t" class="cell-label">1</div></div>
        <div id="lvl-6" class="cell-btn"><div id="lvl-6-t" class="cell-label">2</div></div>
        <div id="lvl-7" class="cell-btn"><div id="lvl-7-t" class="cell-label">3</div></div>
        <div id="lvl-8" class="cell-btn"><div id="lvl-8-t" class="cell-label">4</div></div>
        <div id="lvl-9" class="cell-btn"><div id="lvl-9-t" class="cell-label">5</div></div>
        <div id="lvl-10" class="cell-btn"><div id="lvl-10-t" class="cell-label">6</div></div>
        <div id="lvl-11" class="cell-btn"><div id="lvl-11-t" class="cell-label">7</div></div>
        <div id="lvl-12" class="cell-btn"><div id="lvl-12-t" class="cell-label">8</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-2-label" class="movement-label">II CATCH</div>
        <div id="lvl-13" class="cell-btn"><div id="lvl-13-t" class="cell-label">1</div></div>
        <div id="lvl-14" class="cell-btn"><div id="lvl-14-t" class="cell-label">2</div></div>
        <div id="lvl-15" class="cell-btn"><div id="lvl-15-t" class="cell-label">3</div></div>
        <div id="lvl-16" class="cell-btn"><div id="lvl-16-t" class="cell-label">4</div></div>
