<!--
  HANDCAST HUD. Sections share one panel and are toggled by src/hc/hud.ts:
  #play (current board), #menu (puzzle select), #studio (editor), #hall (community).
  Plain ASCII copy only (font coverage).
-->
<style>
  .root {
    flex-direction: column;
    width: 428px;
    padding-bottom: 14px;
  }
  .section {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 22px;
    padding-right: 22px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #6b6f7a;
  }
  .eyebrow:dark {
    color: rgba(255, 255, 255, 0.6);
  }
  .title {
    margin-top: 4px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #1d1f24;
  }
  .title:dark {
    color: rgba(255, 255, 255, 0.95);
  }
  .status {
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    color: #3a3d45;
  }
  .status:dark {
    color: rgba(255, 255, 255, 0.82);
  }
  .meter {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    height: 14px;
  }
  .meter-dot {
    width: 22px;
    height: 6px;
    border-radius: 3px;
    background-color: #c9ccd4;
  }
  .glass-token {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #8fd0ff;
    border-width: 2px;
    border-color: #2f6bff;
  }
  .spacer {
    width: 14px;
  }
  .row {
    flex-direction: row;
    gap: 8px;
    margin-top: 14px;
    padding-left: 22px;
    padding-right: 22px;
  }
  .tool {
    padding-left: 11px;
    padding-right: 11px;
  }
  .tight {
    gap: 5px;
    padding-left: 16px;
    padding-right: 16px;
  }
  .grid-row {
    flex-direction: row;
    gap: 6px;
    margin-top: 5px;
  }
  .movement-label {
    margin-top: 9px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #6b6f7a;
  }
  .movement-label:dark {
    color: rgba(255, 255, 255, 0.6);
  }
  .cell-btn {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    align-items: center;
    justify-content: center;
    background-color: #e4e6eb;
    cursor: pointer;
  }
  .cell-label {
    font-size: 14px;
    font-weight: 700;
    color: #2a2d33;
  }
  .hall-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    padding-left: 12px;
    padding-right: 12px;
    height: 34px;
    border-radius: 10px;
    background-color: #e9ebf0;
    cursor: pointer;
  }
  .hall-name {
    font-size: 15px;
    font-weight: 600;
    color: #23262c;
  }
  .hall-meta {
    font-size: 13px;
    font-weight: 500;
    color: #5d616b;
  }
  .code {
    margin-top: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #2f6bff;
  }
  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="root">
  <div id="play" class="section">
    <div id="hud-eyebrow" class="eyebrow">PROLOGUE - 1 / 5</div>
    <div id="hud-title" class="title">First Light</div>
    <div id="hud-status" class="status">Rest your palm in the light.</div>
    <div class="meter">
      <div id="tok-0" class="glass-token"></div>
      <div id="tok-1" class="glass-token"></div>
      <div id="tok-2" class="glass-token"></div>
      <div id="tok-3" class="glass-token"></div>
      <div class="spacer"></div>
      <div id="meter-0" class="meter-dot"></div>
      <div id="meter-1" class="meter-dot"></div>
      <div id="meter-2" class="meter-dot"></div>
      <div id="meter-3" class="meter-dot"></div>
      <div id="meter-4" class="meter-dot"></div>
      <div id="meter-5" class="meter-dot"></div>
      <div id="meter-6" class="meter-dot"></div>
      <div id="meter-7" class="meter-dot"></div>
    </div>
  </div>
  <div id="play-actions" class="row">
    <Button id="btn-undo" variant="secondary" size="sm">
      <ButtonIcon><Undo2></Undo2></ButtonIcon>
      <ButtonLabel class="button-label">Undo</ButtonLabel>
    </Button>
    <Button id="btn-reset" variant="secondary" size="sm">
      <ButtonIcon><RotateCcw></RotateCcw></ButtonIcon>
      <ButtonLabel class="button-label">Reset</ButtonLabel>
    </Button>
    <Button id="btn-hint" variant="secondary" size="sm">
      <ButtonIcon><Lightbulb></Lightbulb></ButtonIcon>
      <ButtonLabel class="button-label">Hint</ButtonLabel>
    </Button>
    <Button id="btn-menu" variant="secondary" size="sm">
      <ButtonIcon><LayoutGrid></LayoutGrid></ButtonIcon>
      <ButtonLabel class="button-label">Menu</ButtonLabel>
    </Button>
    <Button id="btn-like" size="sm" style="display: none">
      <ButtonIcon><Heart></Heart></ButtonIcon>
      <ButtonLabel id="btn-like-label" class="button-label">Like</ButtonLabel>
    </Button>
    <Button id="btn-next" size="sm">
      <ButtonLabel class="button-label">Next</ButtonLabel>
      <ButtonIcon><ChevronRight></ChevronRight></ButtonIcon>
    </Button>
  </div>

  <div id="menu" class="section" style="display: none">
    <div class="eyebrow">HANDCAST</div>
    <div class="title">Choose a board</div>
    <div id="ch-0-label" class="movement-label">PROLOGUE - FIRST LIGHT</div>
    <div class="grid-row">
      <div id="lvl-0" class="cell-btn"><div id="lvl-0-t" class="cell-label">1</div></div>
      <div id="lvl-1" class="cell-btn"><div id="lvl-1-t" class="cell-label">2</div></div>
      <div id="lvl-2" class="cell-btn"><div id="lvl-2-t" class="cell-label">3</div></div>
      <div id="lvl-3" class="cell-btn"><div id="lvl-3-t" class="cell-label">4</div></div>
      <div id="lvl-4" class="cell-btn"><div id="lvl-4-t" class="cell-label">5</div></div>
    </div>
    <div id="ch-1-label" class="movement-label">I. FINGERS</div>
    <div class="grid-row">
      <div id="lvl-5" class="cell-btn"><div id="lvl-5-t" class="cell-label">1</div></div>
      <div id="lvl-6" class="cell-btn"><div id="lvl-6-t" class="cell-label">2</div></div>
      <div id="lvl-7" class="cell-btn"><div id="lvl-7-t" class="cell-label">3</div></div>
      <div id="lvl-8" class="cell-btn"><div id="lvl-8-t" class="cell-label">4</div></div>
      <div id="lvl-9" class="cell-btn"><div id="lvl-9-t" class="cell-label">5</div></div>
      <div id="lvl-10" class="cell-btn"><div id="lvl-10-t" class="cell-label">6</div></div>
      <div id="lvl-11" class="cell-btn"><div id="lvl-11-t" class="cell-label">7</div></div>
      <div id="lvl-12" class="cell-btn"><div id="lvl-12-t" class="cell-label">8</div></div>
    </div>
    <div id="ch-2-label" class="movement-label">II. CATCH</div>
    <div class="grid-row">
      <div id="lvl-13" class="cell-btn"><div id="lvl-13-t" class="cell-label">1</div></div>
      <div id="lvl-14" class="cell-btn"><div id="lvl-14-t" class="cell-label">2</div></div>
      <div id="lvl-15" class="cell-btn"><div id="lvl-15-t" class="cell-label">3</div></div>
      <div id="lvl-16" class="cell-btn"><div id="lvl-16-t" class="cell-label">4</div></div>
      <div id="lvl-17" class="cell-btn"><div id="lvl-17-t" class="cell-label">5</div></div>
      <div id="lvl-18" class="cell-btn"><div id="lvl-18-t" class="cell-label">6</div></div>
      <div id="lvl-19" class="cell-btn"><div id="lvl-19-t" class="cell-label">7</div></div>
      <div id="lvl-20" class="cell-btn"><div id="lvl-20-t" class="cell-label">8</div></div>
    </div>
    <div id="ch-3-label" class="movement-label">III. MIRROR PALM</div>
    <div class="grid-row">
      <div id="lvl-21" class="cell-btn"><div id="lvl-21-t" class="cell-label">1</div></div>
      <div id="lvl-22" class="cell-btn"><div id="lvl-22-t" class="cell-label">2</div></div>
      <div id="lvl-23" class="cell-btn"><div id="lvl-23-t" class="cell-label">3</div></div>
      <div id="lvl-24" class="cell-btn"><div id="lvl-24-t" class="cell-label">4</div></div>
      <div id="lvl-25" class="cell-btn"><div id="lvl-25-t" class="cell-label">5</div></div>
      <div id="lvl-26" class="cell-btn"><div id="lvl-26-t" class="cell-label">6</div></div>
      <div id="lvl-27" class="cell-btn"><div id="lvl-27-t" class="cell-label">7</div></div>
      <div id="lvl-28" class="cell-btn"><div id="lvl-28-t" class="cell-label">8</div></div>
    </div>
    <div id="ch-4-label" class="movement-label">IV. RELAY</div>
    <div class="grid-row">
      <div id="lvl-29" class="cell-btn"><div id="lvl-29-t" class="cell-label">1</div></div>
      <div id="lvl-30" class="cell-btn"><div id="lvl-30-t" class="cell-label">2</div></div>
      <div id="lvl-31" class="cell-btn"><div id="lvl-31-t" class="cell-label">3</div></div>
      <div id="lvl-32" class="cell-btn"><div id="lvl-32-t" class="cell-label">4</div></div>
      <div id="lvl-33" class="cell-btn"><div id="lvl-33-t" class="cell-label">5</div></div>
      <div id="lvl-34" class="cell-btn"><div id="lvl-34-t" class="cell-label">6</div></div>
      <div id="lvl-35" class="cell-btn"><div id="lvl-35-t" class="cell-label">7</div></div>
      <div id="lvl-36" class="cell-btn"><div id="lvl-36-t" class="cell-label">8</div></div>
    </div>
    <div id="ch-5-label" class="movement-label">V. COLOUR</div>
    <div class="grid-row">
      <div id="lvl-37" class="cell-btn"><div id="lvl-37-t" class="cell-label">1</div></div>
      <div id="lvl-38" class="cell-btn"><div id="lvl-38-t" class="cell-label">2</div></div>
      <div id="lvl-39" class="cell-btn"><div id="lvl-39-t" class="cell-label">3</div></div>
      <div id="lvl-40" class="cell-btn"><div id="lvl-40-t" class="cell-label">4</div></div>
      <div id="lvl-41" class="cell-btn"><div id="lvl-41-t" class="cell-label">5</div></div>
      <div id="lvl-42" class="cell-btn"><div id="lvl-42-t" class="cell-label">6</div></div>
      <div id="lvl-43" class="cell-btn"><div id="lvl-43-t" class="cell-label">7</div></div>
      <div id="lvl-44" class="cell-btn"><div id="lvl-44-t" class="cell-label">8</div></div>
    </div>
    <div id="ch-6-label" class="movement-label">FINALE - COUNT TO TEN</div>
    <div class="grid-row">
      <div id="lvl-45" class="cell-btn"><div id="lvl-45-t" class="cell-label">1</div></div>
      <div id="lvl-46" class="cell-btn"><div id="lvl-46-t" class="cell-label">2</div></div>
      <div id="lvl-47" class="cell-btn"><div id="lvl-47-t" class="cell-label">3</div></div>
      <div id="lvl-48" class="cell-btn"><div id="lvl-48-t" class="cell-label">4</div></div>
    </div>
  </div>
  <div id="menu-actions" class="row" style="display: none">
    <Button id="btn-daily" size="sm">
      <ButtonIcon><CalendarDays></CalendarDays></ButtonIcon>
      <ButtonLabel id="btn-daily-label" class="button-label">Daily</ButtonLabel>
    </Button>
    <Button id="btn-kiln" variant="secondary" size="sm">
      <ButtonIcon><Flame></Flame></ButtonIcon>
      <ButtonLabel class="button-label">Kiln</ButtonLabel>
    </Button>
    <Button id="btn-studio" variant="secondary" size="sm">
      <ButtonIcon><Hand></Hand></ButtonIcon>
      <ButtonLabel class="button-label">Studio</ButtonLabel>
    </Button>
    <Button id="btn-hall" variant="secondary" size="sm">
      <ButtonIcon><Users></Users></ButtonIcon>
      <ButtonLabel class="button-label">Hall</ButtonLabel>
    </Button>
  </div>
  <div id="menu-actions-2" class="row" style="display: none">
    <Button id="btn-sound" variant="secondary" size="sm">
      <ButtonIcon><Volume2></Volume2></ButtonIcon>
      <ButtonLabel id="btn-sound-label" class="button-label">Sound</ButtonLabel>
    </Button>
    <Button id="btn-assist" variant="secondary" size="sm">
      <ButtonIcon><Accessibility></Accessibility></ButtonIcon>
      <ButtonLabel id="btn-assist-label" class="button-label">Steady</ButtonLabel>
    </Button>
    <Button id="btn-recenter" variant="secondary" size="sm">
      <ButtonIcon><Move></Move></ButtonIcon>
      <ButtonLabel class="button-label">Table</ButtonLabel>
    </Button>
    <Button id="btn-back" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Back</ButtonLabel>
    </Button>
  </div>

  <div id="studio" class="section" style="display: none">
    <div class="eyebrow">STUDIO</div>
    <div class="title">Make a board</div>
    <div id="studio-status" class="status">Cast a hand in the light, then drop crystals where it shines.</div>
    <div id="studio-code" class="code"></div>
  </div>
  <div id="studio-tools" class="row tight" style="display: none">
    <Button id="tool-lamp" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-lamp-t" class="button-label">Lamp</ButtonLabel></Button>
    <Button id="tool-well" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-well-t" class="button-label">Pool</ButtonLabel></Button>
    <Button id="tool-hush" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-hush-t" class="button-label">Hush</ButtonLabel></Button>
    <Button id="tool-wall" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-wall-t" class="button-label">Wall</ButtonLabel></Button>
    <Button id="tool-erase" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-erase-t" class="button-label">Erase</ButtonLabel></Button>
  </div>
  <div id="studio-actions" class="row tight" style="display: none">
    <Button id="btn-studio-undo" variant="secondary" size="sm">
      <ButtonIcon><Undo2></Undo2></ButtonIcon>
      <ButtonLabel class="button-label">Undo</ButtonLabel>
    </Button>
    <Button id="btn-drop" size="sm">
      <ButtonIcon><Sparkles></Sparkles></ButtonIcon>
      <ButtonLabel class="button-label">Crystals</ButtonLabel>
    </Button>
    <Button id="btn-publish" variant="secondary" size="sm">
      <ButtonIcon><Share2></Share2></ButtonIcon>
      <ButtonLabel class="button-label">Publish</ButtonLabel>
    </Button>
    <Button id="btn-studio-exit" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Done</ButtonLabel>
    </Button>
  </div>

  <div id="hall" class="section" style="display: none">
    <div class="eyebrow">HALL OF HANDS</div>
    <div id="hall-title" class="title">Featured</div>
    <div id="hall-0" class="hall-row">
      <div id="hall-0-name" class="hall-name">-</div>
      <div id="hall-0-meta" class="hall-meta"></div>
    </div>
    <div id="hall-1" class="hall-row">
      <div id="hall-1-name" class="hall-name">-</div>
      <div id="hall-1-meta" class="hall-meta"></div>
    </div>
    <div id="hall-2" class="hall-row">
      <div id="hall-2-name" class="hall-name">-</div>
      <div id="hall-2-meta" class="hall-meta"></div>
    </div>
    <div id="hall-3" class="hall-row">
      <div id="hall-3-name" class="hall-name">-</div>
      <div id="hall-3-meta" class="hall-meta"></div>
    </div>
    <div id="hall-4" class="hall-row">
      <div id="hall-4-name" class="hall-name">-</div>
      <div id="hall-4-meta" class="hall-meta"></div>
    </div>
    <div id="hall-5" class="hall-row">
      <div id="hall-5-name" class="hall-name">-</div>
      <div id="hall-5-meta" class="hall-meta"></div>
    </div>
  </div>
  <div id="hall-actions" class="row" style="display: none">
    <Button id="hall-featured" variant="secondary" size="sm"><ButtonLabel class="button-label">Featured</ButtonLabel></Button>
    <Button id="hall-new" variant="secondary" size="sm"><ButtonLabel class="button-label">New</ButtonLabel></Button>
    <Button id="hall-top" variant="secondary" size="sm"><ButtonLabel class="button-label">Top</ButtonLabel></Button>
    <Button id="hall-back" variant="secondary" size="sm"><ButtonLabel class="button-label">Back</ButtonLabel></Button>
  </div>
</Panel>
