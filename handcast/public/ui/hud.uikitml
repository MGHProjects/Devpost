        <div id="lvl-18" class="cell-btn"><div id="lvl-18-t" class="cell-label">6</div></div>
        <div id="lvl-19" class="cell-btn"><div id="lvl-19-t" class="cell-label">7</div></div>
        <div id="lvl-20" class="cell-btn"><div id="lvl-20-t" class="cell-label">8</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-3-label" class="movement-label">III MIRROR</div>
        <div id="lvl-21" class="cell-btn"><div id="lvl-21-t" class="cell-label">1</div></div>
        <div id="lvl-22" class="cell-btn"><div id="lvl-22-t" class="cell-label">2</div></div>
        <div id="lvl-23" class="cell-btn"><div id="lvl-23-t" class="cell-label">3</div></div>
        <div id="lvl-24" class="cell-btn"><div id="lvl-24-t" class="cell-label">4</div></div>
        <div id="lvl-25" class="cell-btn"><div id="lvl-25-t" class="cell-label">5</div></div>
        <div id="lvl-26" class="cell-btn"><div id="lvl-26-t" class="cell-label">6</div></div>
        <div id="lvl-27" class="cell-btn"><div id="lvl-27-t" class="cell-label">7</div></div>
        <div id="lvl-28" class="cell-btn"><div id="lvl-28-t" class="cell-label">8</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-4-label" class="movement-label">IV RELAY</div>
        <div id="lvl-29" class="cell-btn"><div id="lvl-29-t" class="cell-label">1</div></div>
        <div id="lvl-30" class="cell-btn"><div id="lvl-30-t" class="cell-label">2</div></div>
        <div id="lvl-31" class="cell-btn"><div id="lvl-31-t" class="cell-label">3</div></div>
        <div id="lvl-32" class="cell-btn"><div id="lvl-32-t" class="cell-label">4</div></div>
        <div id="lvl-33" class="cell-btn"><div id="lvl-33-t" class="cell-label">5</div></div>
        <div id="lvl-34" class="cell-btn"><div id="lvl-34-t" class="cell-label">6</div></div>
        <div id="lvl-35" class="cell-btn"><div id="lvl-35-t" class="cell-label">7</div></div>
        <div id="lvl-36" class="cell-btn"><div id="lvl-36-t" class="cell-label">8</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-5-label" class="movement-label">V COLOUR</div>
        <div id="lvl-37" class="cell-btn"><div id="lvl-37-t" class="cell-label">1</div></div>
        <div id="lvl-38" class="cell-btn"><div id="lvl-38-t" class="cell-label">2</div></div>
        <div id="lvl-39" class="cell-btn"><div id="lvl-39-t" class="cell-label">3</div></div>
        <div id="lvl-40" class="cell-btn"><div id="lvl-40-t" class="cell-label">4</div></div>
        <div id="lvl-41" class="cell-btn"><div id="lvl-41-t" class="cell-label">5</div></div>
        <div id="lvl-42" class="cell-btn"><div id="lvl-42-t" class="cell-label">6</div></div>
        <div id="lvl-43" class="cell-btn"><div id="lvl-43-t" class="cell-label">7</div></div>
        <div id="lvl-44" class="cell-btn"><div id="lvl-44-t" class="cell-label">8</div></div>
      </div>
      <div class="grid-row">
        <div id="ch-6-label" class="movement-label">FINALE</div>
        <div id="lvl-45" class="cell-btn"><div id="lvl-45-t" class="cell-label">1</div></div>
        <div id="lvl-46" class="cell-btn"><div id="lvl-46-t" class="cell-label">2</div></div>
        <div id="lvl-47" class="cell-btn"><div id="lvl-47-t" class="cell-label">3</div></div>
        <div id="lvl-48" class="cell-btn"><div id="lvl-48-t" class="cell-label">4</div></div>
      </div>
    </div>
    <div class="menu-side">
      <div class="side-head">
        <div class="title">Choose a board</div>
        <Button id="btn-back" variant="secondary" size="sm">
          <ButtonLabel class="button-label">Back</ButtonLabel>
        </Button>
      </div>
      <div id="menu-actions" class="btn-col">
        <div class="btn-pair">
          <Button id="btn-daily" class="wide-btn" size="sm">
            <ButtonIcon><CalendarDays></CalendarDays></ButtonIcon>
            <ButtonLabel id="btn-daily-label" class="button-label">Daily</ButtonLabel>
          </Button>
          <Button id="btn-kiln" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Flame></Flame></ButtonIcon>
            <ButtonLabel class="button-label">Kiln</ButtonLabel>
          </Button>
        </div>
        <div class="btn-pair">
          <Button id="btn-studio" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Hand></Hand></ButtonIcon>
            <ButtonLabel class="button-label">Studio</ButtonLabel>
          </Button>
          <Button id="btn-hall" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Users></Users></ButtonIcon>
            <ButtonLabel class="button-label">Hall</ButtonLabel>
          </Button>
        </div>
      </div>
      <div id="menu-actions-2" class="btn-col">
        <div class="btn-pair">
          <Button id="btn-sound" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Volume2></Volume2></ButtonIcon>
            <ButtonLabel id="btn-sound-label" class="button-label">Sound</ButtonLabel>
          </Button>
          <Button id="btn-assist" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Accessibility></Accessibility></ButtonIcon>
            <ButtonLabel id="btn-assist-label" class="button-label">Steady</ButtonLabel>
          </Button>
        </div>
        <div class="btn-pair">
          <Button id="btn-recenter" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Move></Move></ButtonIcon>
            <ButtonLabel class="button-label">Table</ButtonLabel>
          </Button>
          <Button id="btn-contrast" class="wide-btn" variant="secondary" size="sm">
            <ButtonIcon><Contrast></Contrast></ButtonIcon>
            <ButtonLabel id="btn-contrast-label" class="button-label">Large text</ButtonLabel>
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div id="studio" class="section fixed-w" style="display: none">
    <div class="head-text">
      <div class="title">Make a board</div>
      <div class="eyebrow">STUDIO</div>
    </div>
    <div id="studio-status" class="status">Cast a hand in the light, then drop crystals where it shines.</div>
    <div id="studio-code" class="code"></div>
  </div>
  <div id="studio-tools" class="row tight" style="display: none">
    <Button id="tool-lamp" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-lamp-t" class="button-label">Lamp</ButtonLabel></Button>
    <Button id="tool-well" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-well-t" class="button-label">Pool</ButtonLabel></Button>
    <Button id="tool-hush" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-hush-t" class="button-label">Hush</ButtonLabel></Button>
    <Button id="tool-wall" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-wall-t" class="button-label">Wall</ButtonLabel></Button>
    <Button id="tool-erase" class="tool" variant="secondary" size="sm"><ButtonLabel id="tool-erase-t" class="button-label">Erase</ButtonLabel></Button>
  </div>
  <div id="studio-actions" class="row tight" style="display: none">
    <Button id="btn-studio-undo" variant="secondary" size="sm">
      <ButtonIcon><Undo2></Undo2></ButtonIcon>
      <ButtonLabel class="button-label">Undo</ButtonLabel>
    </Button>
    <Button id="btn-drop" size="sm">
      <ButtonIcon><Sparkles></Sparkles></ButtonIcon>
      <ButtonLabel class="button-label">Crystals</ButtonLabel>
    </Button>
    <Button id="btn-publish" variant="secondary" size="sm">
      <ButtonIcon><Share2></Share2></ButtonIcon>
      <ButtonLabel class="button-label">Publish</ButtonLabel>
    </Button>
    <Button id="btn-studio-exit" variant="secondary" size="sm">
      <ButtonLabel class="button-label">Done</ButtonLabel>
    </Button>
  </div>

  <div id="hall" class="section" style="display: none">
    <div class="head-text">
      <div id="hall-title" class="title">Featured</div>
      <div class="eyebrow">HALL OF HANDS</div>
    </div>
    <div class="hall-grid">
      <div class="hall-pair">
        <div id="hall-0" class="hall-row">
          <div id="hall-0-name" class="hall-name">-</div>
          <div id="hall-0-meta" class="hall-meta"></div>
        </div>
        <div id="hall-1" class="hall-row">
          <div id="hall-1-name" class="hall-name">-</div>
          <div id="hall-1-meta" class="hall-meta"></div>
        </div>
      </div>
      <div class="hall-pair">
